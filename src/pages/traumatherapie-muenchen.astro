---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Container from "../components/Container.astro";
import Divider from "../components/Divider.astro";
import RichText from "../components/RichText.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SectionSubheading from "../components/SectionSubheading.astro";
import RoundImage from "../components/RoundImage.astro";
import Eyebrow from "../components/Eyebrow.astro";
import InfoBox from "../components/InfoBox.astro";
import {
  traumatherapieMuenchenText,
  traumaDefinitionInfo,
  traumaStressverarbeitungInfo,
  traumaKoerpergedaechtnisInfo,
} from "../content/traumatherapie-muenchen-text";
---

<BaseLayout title="Traumatherapie Muenchen I Anja Schmid-Thomae">
  <Hero
    src="/Trauma-anja-Schmid-Thomae.jpg"
    srcset="/Trauma-anja-Schmid-Thomae-p-800.jpeg 800w, /Trauma-anja-Schmid-Thomae-p-1080.jpeg 1080w, /Trauma-anja-Schmid-Thomae-p-1600.jpeg 1600w, /Trauma-anja-Schmid-Thomae.jpg 2000w"
    sizes="(max-width: 767px) 80vw, 436px"
    width="436"
    alt="Eine Frau, die an einem nebeligen Wintertag auf einem Steg steht."
    class="rounded-[50%]"
  />
  <SectionContainer
    ><SectionHeading text="Traumatherapie und Stressverarbeitung" />
    <SectionSubheading text="&bdquo;The slower you go the faster you get there&ldquo;" />
    <Divider />
    <RichText text={traumatherapieMuenchenText} />
    <InfoBox text={traumaDefinitionInfo} class="mt-[20px] [@media(min-width:480px)]:mt-[40px]" />
  </SectionContainer>
  <RoundImage
    src="/Trauma.jpg"
    srcset="/Trauma-p-500.jpeg 500w, /Trauma.jpg 800w"
    sizes="(max-width: 479px) 70vw, (max-width: 767px) 67vw, 383px"
    alt="Grafik einer Frau, die nach fehlenden Puzzleteilen greift, um sich selbst wieder zusammen zu setzen."
  />
  <Container>
    <Eyebrow
      text={'&bdquo;Mitten im winter habe ich erfahren, dass es in mir einen <br>unbesiegbaren sommer gibt&ldquo; <br>- A. Camus'}
      class="text-center "
    />
    <Divider />
    <InfoBox text={traumaStressverarbeitungInfo} class="mb-[20px] [@media(min-width:480px)]:mb-[40px]" />
    <InfoBox text={traumaKoerpergedaechtnisInfo} class="mb-[20px] [@media(min-width:480px)]:mb-[40px]" />
  </Container>
</BaseLayout>
