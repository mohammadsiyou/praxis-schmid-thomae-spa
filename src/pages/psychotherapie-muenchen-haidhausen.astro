---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Container from "../components/Container.astro";
import Divider from "../components/Divider.astro";
import RichText from "../components/RichText.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SectionSubheading from "../components/SectionSubheading.astro";
import RoundImage from "../components/RoundImage.astro";
import Eyebrow from "../components/Eyebrow.astro";
import InfoListCard from "../components/InfoListCard.astro";
import { psychotherapieMuenchenHaidhausenText } from "../content/psychotherapie-muenchen-haidhausen-text";
import {
  therapeutischeAusrichtungTitle,
  therapeutischeAusrichtungItems,
} from "../content/therapeutische-ausrichtung";
---

<BaseLayout title="Psychotherapie Muenchen Haidhausen I Anja Schmid-Thomae">
  <Hero
    src="/Treppe.jpg"
    srcset=""
    sizes=""
    width="436"
    alt="Three-dimensional stairs that enable a variety of perspectives and paths."
    class="rounded-[50%]"
  />
  <SectionContainer
    ><SectionHeading text="Psychotherapie in meiner Praxis" />
    <SectionSubheading text="gemeinsam neue wege beschreiten..." />
    <Divider />
    <RichText text={psychotherapieMuenchenHaidhausenText} />
  </SectionContainer>
  <RoundImage
    src="/FensterAdobe_OriginalHeller.jpg"
    srcset="/FensterAdobe_OriginalHeller-p-500.jpeg 500w, /FensterAdobe_OriginalHeller.jpg 800w"
    sizes="(max-width: 479px) 70vw, (max-width: 767px) 67vw, 396px"
    alt="View through several open doors and windows"
  />
  <Container>
    <Eyebrow
      text={'\"In Wirklichkeit aber ist kein ich, auch nicht das naivste, eine einheit, sondern eine höchst vielfältige welt, ein kleiner sternenhimmel, ein chaos von formen, stufen und zuständen, von erbschaften und möglichkeiten" <br>- H.Hesse'}
      class="text-center pb-[60px]"
    />
    <Divider />
    <InfoListCard
      title={therapeutischeAusrichtungTitle}
      items={therapeutischeAusrichtungItems}
      class="mb-[40px] [@media(min-width:992px)]:mb-[60px]"
    />
  </Container>
</BaseLayout>
