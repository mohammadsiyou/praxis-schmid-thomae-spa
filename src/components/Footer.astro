---
import FooterMain from "./FooterMain.astro";
import SubFooter from "./SubFooter.astro";
---

<footer class="bg-[#f4f4f4] pt-[210px] pb-[20px]">
  <div
    class="max-w-[940px] mx-auto px-[20px] [@media(min-width:480px)]:px-[40px] [@media(min-width:992px)]:px-0"
  >
    <FooterMain />
    <SubFooter class="mt-[120px] [@media(min-width:580px)]:mt-[180px]" />
  </div>
</footer>
